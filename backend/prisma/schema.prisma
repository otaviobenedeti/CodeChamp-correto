generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ==============================
// ENUMS
// ==============================

enum UserRole {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  BUG_FINDING
  CODE_WRITING
  MULTIPLE_CHOICE
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

// ==============================
// USER
// ==============================

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preferences UserPreferences?

  lessonProgresses   UserLessonProgress[]
  questionProgresses UserQuestionProgress[]

  @@map("users")
}

// ==============================
// USER PREFERENCES
// ==============================

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique

  theme Theme @default(SYSTEM)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ==============================
// LESSON
// ==============================

model Lesson {
  id          String  @id @default(cuid())
  title       String
  language    String
  description String?
  youtubeUrl  String

  status     LessonStatus @default(DRAFT)
  difficulty Difficulty?
  order      Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress UserLessonProgress[]

  @@index([status])
  @@index([order])
  @@map("lessons")
}

// ==============================
// USER LESSON PROGRESS
// ==============================

model UserLessonProgress {
  id       String @id @default(cuid())
  userId   String
  lessonId String

  completed   Boolean   @default(false)
  watchedAt   DateTime?
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("user_lesson_progress")
}

// ==============================
// QUESTION
// ==============================

model Question {
  id          String @id @default(cuid())
  title       String
  slug        String @unique
  description String

  type       QuestionType
  difficulty Difficulty
  status     QuestionStatus @default(DRAFT)

  language String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bugFinding     BugFindingQuestion?
  codeWriting    CodeWritingQuestion?
  multipleChoice MultipleChoiceQuestion?

  tags QuestionTag[]

  progress UserQuestionProgress[]

  @@index([type])
  @@index([difficulty])
  @@index([status])
  @@map("questions")
}

// ==============================
// BUG FINDING QUESTION
// ==============================

model BugFindingQuestion {
  id         String @id @default(cuid())
  questionId String @unique

  code        String
  errorLine   Int
  explanation String?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("bug_finding_questions")
}

// ==============================
// CODE WRITING QUESTION
// ==============================

model CodeWritingQuestion {
  id         String @id @default(cuid())
  questionId String @unique

  starterCode  String?
  solutionCode String
  explanation  String?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("code_writing_questions")
}

// ==============================
// MULTIPLE CHOICE QUESTION
// ==============================

model MultipleChoiceQuestion {
  id         String @id @default(cuid())
  questionId String @unique

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  options QuestionOption[]

  @@map("multiple_choice_questions")
}

// ==============================
// QUESTION OPTION
// ==============================

model QuestionOption {
  id         String @id @default(cuid())
  questionId String

  text      String
  isCorrect Boolean @default(false)
  order     Int     @default(0)

  question MultipleChoiceQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

// ==============================
// TAG
// ==============================

model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  questions QuestionTag[]

  @@map("tags")
}

// ==============================
// QUESTION TAG
// ==============================

model QuestionTag {
  questionId String
  tagId      String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@map("question_tags")
}

// ==============================
// USER QUESTION PROGRESS
// ==============================

model UserQuestionProgress {
  id         String @id @default(cuid())
  userId     String
  questionId String

  attempts Int     @default(0)
  solved   Boolean @default(false)

  solvedAt      DateTime?
  lastAttemptAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@map("user_question_progress")
}
